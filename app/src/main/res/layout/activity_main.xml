<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KFOL 爬塔加点计算器"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CPU(精确搜索) + GPU(蒙特卡洛) 并行计算"
            android:textSize="13sp"
            android:textColor="#888888" />

        <!-- 基础参数 (默认已填, 用户可改) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="基础参数"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NPC出现率 (0-99, 四类之和&lt;100, 剩余为普通怪)"
            android:textSize="12sp"
            android:textColor="#666666" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="强壮出现率"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/npcRateStrgInput"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="坚强出现率"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/npcRateToghInput"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="快速出现率"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/npcRateFastInput"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="睿智出现率"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/npcRateClvrInput"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="神秘系数 (默认 11)"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/coefInput"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="战力光环 (千分率)"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/auraInput"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="HP回复量 (默认 8)"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/hpHealInput"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="HP step (越大越快越粗)"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/hpStepInput"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </LinearLayout>

        <!-- 道具数量 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="道具数量 (按争夺界面顺序)"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="蕾米同人漫画 (+1力/体, 满50 +700生命)"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/itemRemInput"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:hint="0"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="十六夜同人漫画 (+1敏/灵, 满50 +100攻速)"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/itemIzaInput"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:hint="0"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="档案室钥匙 (+1%盒子率, 满30 +30点)"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/itemKeyInput"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:hint="0"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="傲娇LOLI娇蛮音CD (降敌生命0.8%/张)"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/itemLolInput"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:hint="0"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="消逝之药 (全属性+5/瓶, 满10 +120点)"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/itemYaoInput"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:hint="0"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="整形优惠卷 (满10 [极]加成)"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/itemZheInput"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:hint="0"
                android:inputType="number" />
        </LinearLayout>

        <!-- 分配点数: 实时计算最佳加点 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="可分配点数 (输入后实时计算最佳加点)"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/pointsInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="可分配点数"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="最佳加点 (可手动修改, 输入点数后自动计算覆盖)"
            android:textSize="12sp"
            android:textColor="#666666" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="力量"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/attrStrInput"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="体质"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/attrVitInput"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="敏捷"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/attrAgiInput"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="灵活"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/attrDexInput"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="智力"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/attrIntInput"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="意志"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/attrResInput"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="耐力"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/attrStaInput"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="幸运"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/attrLukInput"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </LinearLayout>

        <!-- 计算模式 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="计算模式"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/modeFromFirst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="从第一层开始" />

            <RadioButton
                android:id="@+id/modeFromLvl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="从指定层开始" />
        </RadioGroup>

        <EditText
            android:id="@+id/startLvlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:hint="起始层数 (选「从指定层开始」时生效)"
            android:inputType="number" />

        <EditText
            android:id="@+id/maxLvlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="目标层数 / 最大层数 (超过视为打不赢)"
            android:inputType="number" />

        <!-- 装备等级 + 粘贴 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="装备等级"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/wpnLvlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="武器等级"
            android:inputType="number" />

        <EditText
            android:id="@+id/amrLvlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="护甲等级"
            android:inputType="number" />

        <EditText
            android:id="@+id/neckLvlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:hint="项链等级 (绝版, 固定 0)"
            android:inputType="number"
            android:text="0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="装备粘贴 (绯月复制后一键粘贴)"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="类型: Fist/Sword/Bow/Staff(武器) · Body/Plate/Leather/Cloth(防具)"
            android:textSize="11sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/equipInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="【例如：】&#10;Cloth #90442450&#10;1 IMT&#10;4 AMR RFL CRD SLD&#10;8 HEL COF 5 HEL COF 2 SRD COF 5 SLD VIT 5 SRD COF 3 SLD DEX 5 AMR RES 3 HEL COF 2&#10;&#10;Sword #89545072&#10;1 AMT&#10;4 BRC CRT LCH SKL&#10;8 CRT INT 3 BRC AGI 3 BRC COF 4 BRC AGI 5 LCH COF 2 ATK STR 2 SPD AGI 2 BRC INT 5"
            android:inputType="textMultiLine"
            android:minLines="6"
            android:maxLines="12"
            android:textSize="13sp" />

        <Button
            android:id="@+id/pasteBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="一键粘贴" />

        <Button
            android:id="@+id/parseEquipBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="解析装备并加入计算" />

        <TextView
            android:id="@+id/equipInfoView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text=""
            android:textSize="12sp" />

        <Button
            android:id="@+id/searchBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="开始计算" />

        <!-- 高级选项 (LIMIT ~ MINWINRATE 一键粘贴) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="高级选项 (LIMIT ~ MINWINRATE)"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="从 kfol.in 可选选项区复制后一键粘贴, 默认已填推荐配置"
            android:textSize="11sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/optInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="LIMIT 1 200&#10;VIT MAX 150&#10;ENDLIMIT&#10;MAXROUND 15&#10;FASTSKILL 4&#10;TOUGHSKILL 1&#10;BATTLESTEP 10&#10;GRIDOPTION 6 3 5&#10;MINWINRATE 100"
            android:inputType="textMultiLine"
            android:minLines="8"
            android:maxLines="14"
            android:textSize="13sp" />

        <Button
            android:id="@+id/pasteOptBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="一键粘贴高级选项" />

        <TextView
            android:id="@+id/statusView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textSize="14sp" />

        <TextView
            android:id="@+id/resultView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text=""
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>